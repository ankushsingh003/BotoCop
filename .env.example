# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_VISION_MODEL_NAME=gemini-2.5-flash

# Server Configuration
PORT=8000

# LangSmith / LangChain Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=brand-compliance-rules

# RAG Configuration
RAG_MMR_LAMBDA=0.5

# Case store (defaults to a local SQLite file if unset -- point this at a
# managed Postgres instance in production)
# CASE_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/botocop

# Data lake (MinIO/S3). Unset MINIO_ENDPOINT to use real AWS S3 defaults
# instead of a local MinIO server.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
DATALAKE_BUCKET=botocop-datalake

# Kafka (only needed for the Kafka ingestion path / worker service --
# the WebSocket path works without any of these)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=fraud.transaction.events
KAFKA_CALL_TOPIC=fraud.call.events
KAFKA_TEXT_TOPIC=fraud.text.events
KAFKA_VIDEO_TOPIC=fraud.video.events
KAFKA_RESULTS_TOPIC=fraud.case.updates
KAFKA_CONSUMER_GROUP=fraud-orchestrator
