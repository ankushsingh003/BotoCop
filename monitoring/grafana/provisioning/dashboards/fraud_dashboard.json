{
  "title": "BotoCop Fraud Detection",
  "uid": "botocop-fraud-detection",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events processed / sec, by channel",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (channel) (rate(botocop_events_processed_total[5m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Violations detected / sec, by severity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (severity) (rate(botocop_violations_detected_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pipeline duration, p50 / p95 by channel",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (channel, le) (rate(botocop_pipeline_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{channel}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (channel, le) (rate(botocop_pipeline_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{channel}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Eval-loop retries / sec, by channel",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (channel) (rate(botocop_eval_retries_total[5m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Case status transitions / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(botocop_case_status_transitions_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cross-channel case risk score, p50 / p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(botocop_case_risk_score_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(botocop_case_risk_score_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Open cases (live)",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "botocop_open_cases",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      }
    }
  ]
}